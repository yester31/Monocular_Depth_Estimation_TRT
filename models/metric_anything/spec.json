{
  "schema": 1,
  "name": "metric_anything",
  "env": "metric_anything",
  "input": {
    "name": "image",
    "rank": 4,
    "dtype": "float32",
    "layout": "NCHW"
  },
  "outputs": [
    {
      "name": "points",
      "meaning": "point map"
    },
    {
      "name": "mask",
      "meaning": "valid mask"
    },
    {
      "name": "metric_scale",
      "meaning": "scalar metric scale"
    }
  ],
  "profiles": {
    "bench": {
      "size": [
        388,
        518
      ]
    }
  },
  "build_targets": [
    {
      "profile": "bench",
      "precision": "fp16"
    }
  ],
  "caveats": [
    "388x518 assumes a 4:3 source, matching moge_2 (D13)",
    "post-process calls MoGe's recover_focal_shift, so trte needs the pinned utils3d commit (D15)"
  ]
}
