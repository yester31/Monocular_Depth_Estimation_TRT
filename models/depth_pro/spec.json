{
  "schema": 1,
  "name": "depth_pro",
  "env": "depth-pro",
  "input": {
    "name": "input",
    "rank": 4,
    "dtype": "float32",
    "layout": "NCHW",
    "normalize": {
      "mean": [
        0.5,
        0.5,
        0.5
      ],
      "std": [
        0.5,
        0.5,
        0.5
      ],
      "scale": 255.0,
      "source": "onnx2trt.py Compose([ToTensor(), Normalize([0.5]*3,[0.5]*3)])"
    }
  },
  "outputs": [
    {
      "name": "canonical_inverse_depth",
      "meaning": "inverse depth, canonical camera"
    },
    {
      "name": "fov_deg",
      "meaning": "field of view in degrees"
    }
  ],
  "profiles": {
    "native": {
      "size": [
        1536,
        1536
      ]
    }
  },
  "build_targets": [
    {
      "profile": "native",
      "precision": "fp16"
    }
  ],
  "caveats": [
    "1536x1536 is upstream's fixed size; there is no 518 bench profile"
  ],
  "encoder": {
    "used": "fixed",
    "available": [
      "fixed"
    ],
    "smallest": "fixed",
    "source": "upstream clone, checked 2026-08-13"
  },
  "depth_scale": "metric",
  "preprocess": {
    "type": "stretch",
    "normalise": "half",
    "interpolation": "torch_bilinear",
    "note": "normalised before the resize, and the resize is torch's bilinear with align_corners=False, not cv2's",
    "verified": "exact against reports/inputs/depth_pro.npy via evaluate_gt's adapter",
    "adapter_check": {"oracle": "reports/inputs/depth_pro.npy", "max_abs_diff": 0.0, "atol": 1e-4}
  }
}
