{
  "schema": 1,
  "name": "vggt",
  "env": "vggt",
  "input": {
    "name": "images",
    "rank": 5,
    "dtype": "float32",
    "layout": "NSCHW",
    "normalize": {
      "mean": [
        0.0,
        0.0,
        0.0
      ],
      "std": [
        1.0,
        1.0,
        1.0
      ],
      "scale": 255.0,
      "source": "onnx2trt.py: /255 only, no mean/std"
    }
  },
  "outputs": [
    {
      "name": "depth",
      "meaning": "depth; global scale unknown"
    }
  ],
  "profiles": {
    "bench": {
      "size": [
        518,
        518
      ]
    }
  },
  "build_targets": [
    {
      "profile": "bench",
      "precision": "fp16"
    }
  ],
  "caveats": [
    "cartesian_prod is replaced at export time; TorchScript has no symbolic for it (core/export_compat.no_cartesian_prod)"
  ],
  "encoder": {
    "used": "fixed",
    "available": [
      "fixed"
    ],
    "smallest": "fixed",
    "source": "upstream clone, checked 2026-08-13"
  },
  "depth_scale": "unknown",
  "preprocess": {
    "type": "keep_ratio_pad",
    "normalise": "over_255",
    "interpolation": "cubic",
    "note": "square pad first, then resize; scale = size / max_dim",
    "verified": "transcribed from onnx2trt.py; no ground-truth adapter checks it yet"
  }
}